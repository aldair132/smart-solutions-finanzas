# Configura UNA de estas claves en .env.local (local) o en Vercel > Settings > Environment Variables.
# Sin clave, la app funciona en "modo demostración" con extracciones de ejemplo.

# Opción A — Gemini (tier gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Voz neuronal de las respuestas: gratis (~10 usos diarios por modelo, sin facturación
# no hay cobros). Al agotarse se usa la voz del navegador. Pon "false" mientras pruebas
# para guardar la cuota para la presentación.
# GEMINI_TTS_ENABLED=true
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# Opción B — Claude (se usa solo si no hay GEMINI_API_KEY; no procesa audio): https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
